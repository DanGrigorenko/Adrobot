# Server-only values. Copy to .env and replace locally; never commit .env.
KEITARO_BASE_URL=https://keitaro.example
KEITARO_API_KEY=replace-with-server-side-key
# Keep this equal to the browser address; no trailing slash.
APP_ORIGIN=http://127.0.0.1:8000
# Set existing positive IDs from your Keitaro. Empty/unavailable values block Creator.
CREATOR_DOMAIN_ID=
CREATOR_GROUP_ID=
CREATOR_TRAFFIC_SOURCE_ID=
# Optional test profile prefix, including its separator; no personal values in Git.
CREATOR_NAME_PREFIX=test_example_
